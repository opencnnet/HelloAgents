{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HelloAgents Chat",
  "version": "0.1.0",
  "identifier": "cn.helloagents.chat",
  "build": {
    "beforeDevCommand": "corepack pnpm@9.15.4 icon && corepack pnpm@9.15.4 dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "corepack pnpm@9.15.4 icon && corepack pnpm@9.15.4 build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HelloAgents 对话",
        "width": 1200,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:5173 http://127.0.0.1:5173"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/helloagents-backend"],
    "resources": {
      "../../skills": "skills"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
