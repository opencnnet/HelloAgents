# ===== 可选：内置默认配置（首次启动兜底；UI 内保存的配置优先级更高） =====
# 接口类型：openai / local / custom / helloagents
VITE_DEFAULT_API_TYPE=openai
VITE_DEFAULT_API_ENDPOINT=
VITE_DEFAULT_MODEL=

# 开发调试：设为 mock 时使用离线模拟流，不发起真实网络请求
# VITE_TRANSPORT=mock

# 本地联调开关：设为 1 时打开应用即默认使用 HelloAgents 模式并连接本地服务
# Web 端使用页面同源地址（走 Vite 的 /agent 代理），桌面端使用 http://127.0.0.1:8000
# VITE_AUTO_CONNECT_HELLOAGENTS=1

# 注意：不要把 API Key 写入本文件或任何会被提交的文件。
# 密钥只在应用设置中保存到本机。
